---
import Image from "./Image.astro";

// the track is a plain scroll-snap container, so a trackpad, a swipe and the
// keyboard all work before any JS runs; the script adds the arrows, the
// indicators and the unattended advance.
interface Props {
  slides: { image: ImageMetadata; alt: string }[];
  label: string;
  class?: string;
  imageClass?: string;
}

const { slides, label, class: className, imageClass } = Astro.props;

// the controls sit on the photo, so they carry their own ground: a cream
// hairline over a dark wash reads on the meadow and on the ferns alike
const arrow =
  "absolute top-1/2 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center border border-cream/70 bg-ink/40 text-cream hover:bg-ink/65";
---

<div class:list={["relative", className]} data-carousel>
  <div
    data-track
    role="group"
    aria-roledescription="karuzela"
    aria-label={label}
    tabindex="0"
    class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      slides.map((slide, i) => (
        <figure
          class="m-0 w-full shrink-0 snap-start"
          role="group"
          aria-roledescription="slajd"
          aria-label={`${i + 1} z ${slides.length}`}
        >
          <Image
            blur
            class:list={["w-full object-cover", imageClass]}
            src={slide.image}
            alt={slide.alt}
            widths={[480, 768, 1024, 1280, 1600]}
            sizes="(min-width: 768px) min(46vw, 700px), 100vw"
            loading="eager"
            fetchpriority={i === 0 ? "high" : "low"}
            quality={85}
          />
        </figure>
      ))
    }
  </div>

  <button
    type="button"
    data-prev
    data-arrow
    aria-label="poprzednie zdjęcie"
    class:list={[arrow, "left-3 sm:left-4"]}
  >
    <svg
      class="size-4 rotate-180"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </button>
  <button
    type="button"
    data-next
    data-arrow
    aria-label="następne zdjęcie"
    class:list={[arrow, "right-3 sm:right-4"]}
  >
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </button>

  <div class="absolute bottom-2 left-2 z-10 flex">
    {
      slides.map((_, i) => (
        <button
          type="button"
          data-dot
          aria-label={`zdjęcie ${i + 1}`}
          aria-current={i === 0 ? "true" : "false"}
          class="group flex h-8 w-5 cursor-pointer items-center justify-center"
        >
          <span class="size-2 border border-cream/85 drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)] group-aria-[current=true]:bg-cream" />
        </button>
      ))
    }
  </div>
</div>

<style>
  /* the arrows only surface under the pointer (or on keyboard focus) so the
     photo is unobstructed at rest — no fade, per DESIGN.md */
  [data-arrow] {
    opacity: 0;
  }
  [data-carousel]:hover [data-arrow],
  [data-arrow]:focus-visible {
    opacity: 1;
  }
  [data-carousel]:hover [data-arrow]:disabled {
    opacity: 0.25;
  }
</style>

<script>
  // unattended pace: slow enough to read a photo, and it walks back down the
  // strip at the end instead of rewinding past every slide.
  const ADVANCE_MS = 5000;
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    if (!track || !prev || !next) continue;

    const last = dots.length - 1;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);

    const go = (i: number) => {
      track.scrollTo({
        left: Math.min(Math.max(i, 0), last) * track.clientWidth,
        behavior: calm.matches ? "auto" : "smooth",
      });
    };

    const sync = () => {
      const i = current();
      dots.forEach((dot, j) =>
        dot.setAttribute("aria-current", String(i === j)),
      );
      prev.disabled = i === 0;
      next.disabled = i === last;
    };

    // taking hold of the carousel ends the unattended advance for good; merely
    // hovering, focusing, scrolling it out of sight or hiding the tab holds it.
    let timer = 0;
    let step = 1;
    let held = false;
    let onScreen = true;
    let done = calm.matches;

    const advance = () => {
      const i = current();
      if (i >= last) step = -1;
      if (i <= 0) step = 1;
      go(i + step);
    };

    const pace = () => {
      clearInterval(timer);
      if (!done && !held && onScreen && !document.hidden) {
        timer = setInterval(advance, ADVANCE_MS);
      }
    };

    const stop = () => {
      done = true;
      pace();
    };
    const hold = (on: boolean) => {
      held = on;
      pace();
    };

    prev.addEventListener("click", () => go(current() - 1));
    next.addEventListener("click", () => go(current() + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => go(i)));

    root.addEventListener("pointerdown", stop);
    // Tab only passes through the carousel — it is not a grab
    root.addEventListener("keydown", (e) => e.key !== "Tab" && stop());
    root.addEventListener("pointerenter", () => hold(true));
    root.addEventListener("pointerleave", () => hold(false));
    root.addEventListener("focusin", () => hold(true));
    root.addEventListener("focusout", () => hold(false));
    document.addEventListener("visibilitychange", pace);
    calm.addEventListener("change", () => {
      done ||= calm.matches;
      pace();
    });
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      pace();
    }).observe(root);

    let queued = false;
    track.addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    });
    // a resize changes clientWidth, so the snapped slide has to be re-read
    addEventListener("resize", sync);
    sync();
    pace();
  }
</script>
