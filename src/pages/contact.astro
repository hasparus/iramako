---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Section from "../components/Section.astro";
import NavLink from "../components/NavLink.astro";
import Instagram from "../components/icons/Instagram.astro";
import ContactIcon from "../components/icons/Contact.astro";
import Phone from "../components/icons/Phone.astro";

const instagramUrl = "https://www.instagram.com/ira.mako/";
---

<BaseLayout
  title="Kontakt | iramako"
  description="Skontaktuj się z iramako — sklep stacjonarny we Wrocławiu, e-mail, telefon i Instagram."
>
  <main class="min-h-screen w-full">
    <Navbar instagramUrl={instagramUrl} />

    <Section
      border="none"
      containerClass="py-14 sm:py-[clamp(56px,8vw,110px)]"
    >
      <h1 class="block text-3xl font-bold leading-[1.02] tracking-[-0.04em]">
        Napisz do nas
      </h1>

      <!-- relative z-40 lifts these links above the z-30 splash overlay so
           the splotch tints behind the text instead of multiplying over it -->
      <div class="relative z-40 mt-12 flex max-w-140 flex-col">
        <div class="flex items-center gap-4 py-5 text-xl text-ink">
          <ContactIcon />
          <NavLink href="mailto:centrala@iramako.pl" splash="szary"
            >centrala@iramako.pl</NavLink
          >
        </div>

        <div class="h-px bg-rule/50 w-[70%]"></div>

        <div class="flex items-center gap-4 py-5 text-xl text-ink">
          <Phone />
          <NavLink
            href="tel:+48573437735"
            splash="arbuz"
            class="whitespace-nowrap"
            >+48 573 437 735</NavLink
          >
        </div>

        <div class="h-px bg-rule/50 w-[70%]"></div>

        <div class="flex items-center gap-4 py-5 text-xl text-ink">
          <Instagram />
          <NavLink
            href={instagramUrl}
            target="_blank"
            rel="noreferrer"
            splash="szary">@ira.mako</NavLink
          >
        </div>
      </div>
    </Section>

    <SiteFooter instagramUrl={instagramUrl} />
  </main>
</BaseLayout>
