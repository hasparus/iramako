---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Section from "../components/Section.astro";
import NavLink from "../components/NavLink.astro";
import Instagram from "../components/icons/Instagram.astro";
import ContactIcon from "../components/icons/Contact.astro";
import type { SplashName } from "../assets/splashes";

const instagramUrl = "https://www.instagram.com/ira.mako/";

const channels: {
  Icon: typeof ContactIcon;
  href: string;
  label: string;
  splash: SplashName;
  target?: string;
  rel?: string;
}[] = [
  {
    Icon: ContactIcon,
    href: "mailto:centrala@iramako.pl",
    label: "centrala@iramako.pl",
    splash: "szary",
  },
  {
    Icon: Instagram,
    href: instagramUrl,
    label: "@ira.mako",
    splash: "szary",
    target: "_blank",
    rel: "noreferrer",
  },
];
---

<BaseLayout
  title="Kontakt | iramako"
  description="Sklep stacjonarny iramako mieści się przy pl. Uniwersyteckim 7 we Wrocławiu. Napisz na centrala@iramako.pl albo odezwij się na Instagramie."
>
  <main class="min-h-screen w-full">
    <Navbar instagramUrl={instagramUrl} />

    <Section border="none" containerClass="py-14 sm:py-[clamp(56px,8vw,110px)]">
      <h1 class="block text-3xl font-bold leading-[1.02] tracking-[-0.04em]">
        Napisz do nas
      </h1>

      {/* relative z-40 lifts these links above the z-30 splash overlay so
          the splotch tints behind the text instead of multiplying over it */}
      <div class="relative z-40 mt-12 flex max-w-140 flex-col">
        {
          channels.map(({ Icon, href, label, splash, target, rel }, i) => (
            <>
              {i > 0 && <div class="h-px w-[70%] bg-rule/50" />}
              <div class="flex items-center gap-4 py-5 text-xl text-ink">
                <Icon />
                <NavLink
                  href={href}
                  target={target}
                  rel={rel}
                  splash={splash}
                  class="whitespace-nowrap"
                >
                  {label}
                </NavLink>
              </div>
            </>
          ))
        }
      </div>
    </Section>

    <SiteFooter instagramUrl={instagramUrl} />
  </main>
</BaseLayout>
